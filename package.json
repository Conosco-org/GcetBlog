    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": "3.4.11",
      "esbuild": "0.28.1",
      "fast-xml-parser": "5.7.0",
