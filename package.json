  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/typography": "^0.5.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.5.4",
    "@types/nodemailer": "^7.0.9",
